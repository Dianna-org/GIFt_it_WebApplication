JWT_KEY=replace-with-a-long-random-string
# Secret mixed into every password hash (round 44). Keep it secret and NEVER change it once accounts exist:
# with another pepper nobody could log in any more. deploy.sh / runlocal.sh make a random one for you.
PASSWORD_PEPPER=replace-with-another-long-random-string

# Round 46 – emails (sign-up codes, account confirmation, cards sent to someone).
# Leave these out to use the free test inbox (Mailpit): every email shows up at http://localhost:8025.
# Real emails with Gmail (free, ~500 a day): turn on 2-Step Verification in your Google account, make an
# App Password (Google account -> Security -> App passwords) and fill in:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=the-16-letter-app-password
# SMTP_FROM=GIFt it! <your.address@gmail.com>
# The address in the links of shared cards (change it when the app is online):
# PUBLIC_URL=http://localhost:3000
